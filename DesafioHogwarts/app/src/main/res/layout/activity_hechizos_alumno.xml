<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="16dp"
    android:background="@drawable/comedorhogwart">

    <!-- TÍTULO DE LA CLASE -->
    <TextView
        android:id="@+id/txtTituloHechizos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Clase de Hechizos"
        android:textSize="28sp"
        android:textColor="#FFD700"
        android:textStyle="bold"
        android:shadowColor="#000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:layout_marginBottom="16dp" />

    <!-- CONTENEDOR SEMITRANSPARENTE PARA EL CONTENIDO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"
        android:background="#AA000000"
        android:orientation="vertical"
        android:gravity="center">

        <!-- LISTA DE HECHIZOS -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHechizos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="4dp" />

    </LinearLayout>

    <!-- BOTÓN VOLVER (OPCIONAL) -->
    <Button
        android:id="@+id/btnVolverHechizos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Volver"
        android:textSize="16sp"
        android:padding="10dp"
        android:layout_marginTop="12dp"
        android:background="#88000000"
        android:textColor="#FFD700"
        android:drawablePadding="8dp" />

</LinearLayout>

